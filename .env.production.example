# Core app
NODE_ENV=production
NEXT_PUBLIC_APP_URL=https://your-domain.example

# Clerk auth
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/auth/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/auth/sign-up

# Primary application database
DATABASE_URL=
# Direct Postgres connection for Prisma CLI commands like migrate deploy.
# For Supabase, use the non-pooler host on port 5432.
DIRECT_URL=

# External chat database
# Use the same Postgres as DATABASE_URL or a dedicated one.
CHAT_DATABASE_URL=
# Optional direct Postgres connection for chat migrations.
CHAT_DIRECT_URL=
# Optional: only needed when using Supabase pooler and the username must be normalized.
CHAT_SUPABASE_PROJECT_REF=
# Optional CA bundle path when your host requires a custom root cert.
CHAT_DATABASE_SSL_ROOT_CERT=

# 3D image generation provider selection
# Supported: openai, huggingface
IMAGE_GENERATION_PROVIDER=openai
THREE_D_GENERATION_API_KEY=
THREE_D_GENERATION_OPENAI_API_KEY=

# OpenAI image generation
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-1

# Hugging Face fallback / alternate provider
HUGGINGFACE_API_KEY=
HUGGINGFACE_IMAGE_MODEL=stabilityai/stable-diffusion-xl-base-1.0

# Generated image storage
# Bucket/region/credentials fall back to the shared AWS_* vars below.
GENERATED_IMAGES_S3_PREFIX=3dgenerated-images
GENERATED_IMAGES_SIGNED_URL_TTL_SECONDS=900
GENERATED_IMAGES_HISTORY_LIMIT=24
GENERATED_IMAGES_PER_MINUTE=6

# Shared AWS fallback used by uploads/generated images when dedicated keys are omitted
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_DEFAULT_REGION=us-east-1
RATE_LIMITING_ENABLED=false

# External chat uploads
EXTERNAL_CHAT_MAX_UPLOAD_BYTES=26214400
EXTERNAL_CHAT_UPLOADS_PER_MINUTE=10
EXTERNAL_CHAT_MESSAGES_PER_MINUTE=40
EXTERNAL_CHAT_SEARCHES_PER_MINUTE=45
EXTERNAL_CHAT_CONNECTION_REQUESTS_PER_HOUR=25
EXTERNAL_CHAT_LINK_PREVIEW_PER_MINUTE=30
EXTERNAL_CHAT_LINK_PREVIEW_MAX_BYTES=512000
EXTERNAL_CHAT_MAX_MESSAGE_LENGTH=4000

# External chat attachment storage
EXTERNAL_CHAT_S3_BUCKET=
EXTERNAL_CHAT_S3_PREFIX=chat-system
EXTERNAL_CHAT_AWS_REGION=us-east-1
EXTERNAL_CHAT_AWS_ACCESS_KEY_ID=
EXTERNAL_CHAT_AWS_SECRET_ACCESS_KEY=
EXTERNAL_CHAT_SIGNED_URL_TTL_SECONDS=900
